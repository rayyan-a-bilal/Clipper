{
  "schema_version": 1,
  "id": "compact",
  "label": "Compact (smaller captions, tighter margins)",
  "caption": {
    "enabled": true,
    "hook_enabled": true,
    "burn_in": "full",
    "font": "Montserrat ExtraBold",
    "size": 64,
    "margin_v": 300,
    "margin_l": 80,
    "margin_r": 80,
    "safe_top": 180,
    "safe_right": 80,
    "safe_zone_platform": "none",
    "max_words": 3,
    "max_line_chars": 16,
    "max_lines": 2,
    "primary": "&HFFFFFF&",
    "highlight": "&H00FFFF&",
    "outline": 3,
    "shadow": 0,
    "bold": true,
    "karaoke": true
  },
  "layout": {
    "score_threshold": 0.5,
    "face_follow_enabled": true,
    "follow_persistence_min": 0.3
  }
}
