[Unit]
Description=Clipper LLM Service
After=network.target

[Service]
Type=simple
User=clipper
WorkingDirectory=/opt/clipper
EnvironmentFile=/etc/clipper.env
ExecStart=/opt/clipper/.venv/bin/llama-server --model /models/llama.cpp --host 0.0.0.0 --port 8081
Restart=always

[Install]
WantedBy=multi-user.target